\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{idea2paper-draft}[2026/08/10 Tracked draft placeholders and non-floating teaser for idea2paper]

\RequirePackage{xcolor}

\definecolor{IdeaTwoPaperDraftRed}{RGB}{190,35,35}

% The first argument is a stable TODO/result ID retained in source.
\newcommand{\PredResult}[2]{\textcolor{IdeaTwoPaperDraftRed}{#2}}
\newcommand{\PredClaim}[2]{\textcolor{IdeaTwoPaperDraftRed}{#2}}
\newcommand{\DraftChoice}[2]{\textcolor{IdeaTwoPaperDraftRed}{#2}}
% Keep qualitative replacement text breakable inside captions. The generated
% placeholder raster carries the prominent disclosure; an unbreakable fbox here
% can overflow a single-column caption and disturb float placement.
\newcommand{\QualPlaceholder}[2]{\textcolor{IdeaTwoPaperDraftRed}{#2}}
\newcommand{\TemplateTODO}[2]{%
  \PackageWarningNoLine{idea2paper-draft}{#1: #2}%
  \par\noindent\textcolor{IdeaTwoPaperDraftRed}{\textbf{Template TODO (#1):} #2}\par%
}

% Obsolete compatibility guard. A teaser belongs after the complete title/author
% block and before the abstract, so main.tex must input it immediately after
% \maketitle. Patching template-internal \@maketitle tokens is deliberately banned.
\newcommand{\IdeaTwoPaperPatchTitleTeaser}[2]{%
  \PackageError{idea2paper-draft}%
    {Obsolete title--teaser hook}%
    {Remove \string\IdeaTwoPaperPatchTitleTeaser\space and place \string\input{sections/teaser} immediately after \string\maketitle\space and before the abstract.}%
}

% The teaser remains source-anchored and non-floating between \maketitle and the
% abstract. Keep includegraphics literal in the environment body so project
% validation can still bind the raster to the imagegen manifest.
\newenvironment{IdeaTwoPaperTitleTeaser}[2]{%
  \def\IdeaTwoPaperTeaserCaption{#1}%
  \def\IdeaTwoPaperTeaserLabel{#2}%
  \par\vspace{0.8em}%
  \begin{center}%
}{%
  \par\vspace{0.35em}%
  \refstepcounter{figure}%
  \begin{minipage}{0.96\linewidth}%
    \small\textbf{Figure~\thefigure:} \IdeaTwoPaperTeaserCaption%
    \label{\IdeaTwoPaperTeaserLabel}%
  \end{minipage}%
  \end{center}%
  \vspace{0.5em}%
}

\endinput
